# Copy to .env (gitignored) and fill in. Never commit .env.
# Teacher model for src/generate.py (any OpenAI-compatible API).
TEACHER_BASE_URL=https://api.groq.com/openai/v1
TEACHER_API_KEY=
# low | medium | high (gpt-oss on Groq); leave empty for providers that don't support it
TEACHER_REASONING_EFFORT=medium
TEACHER_MODEL=
# Optional: BLS v2 key for more requests per day (https://data.bls.gov/registrationEngine/)
BLS_API_KEY=
